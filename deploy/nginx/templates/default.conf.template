# Rendered at container start by the nginx image's envsubst pass.
# Substituted: ${APP_DOMAIN}, ${API_DOMAIN}. Runtime nginx variables ($host,
# $remote_addr, …) are untouched because they are not environment variables.
#
# WHY TWO HOSTNAMES, not one host with /api/ pointed at FastAPI:
# the dashboard's BFF owns /api/* on its own origin — Next route handlers read
# the httpOnly nc_token cookie and re-issue the call to FastAPI with a Bearer
# header. Mounting FastAPI under /api/ here would shadow those handlers, the
# cookie would never be exchanged, and every dashboard request would 401.
# The API therefore gets its own subdomain; only the Flutter app calls it.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN} ${API_DOMAIN};

    # Certbot's webroot challenge has to stay reachable over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── Dashboard (Next.js) ───────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Monitoring photos post through the BFF proxy and the backend caps them at
    # 5 MB — nginx's 1 MB default would reject them first. (This is the knob
    # Vercel did not expose; its hard limit was ~4.5 MB.)
    client_max_body_size 10m;

    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # PDF report generation is the slow path worth sizing for.
        proxy_read_timeout 120s;
    }
}

# ── API (FastAPI) — Flutter client, /uploads, /docs ───────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 10m;

    location / {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
