# Copy to web/.env.local for local development.
# On Vercel, set this in Project Settings → Environment Variables instead.

# FastAPI backend base URL (server-side only — never exposed to the browser).
# Local:      http://localhost:8000
# Production: public HTTPS origin of the deployed backend, no trailing slash
#             e.g. https://neonatal-backend.onrender.com
API_BASE_URL=http://localhost:8000
