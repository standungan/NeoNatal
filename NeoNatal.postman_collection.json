            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"baby_name\": \"Ahmad Rizki\",\n  \"birth_weight\": 2450.0,\n  \"clinical_notes\": \"Kondisi membaik\"\n}" },
