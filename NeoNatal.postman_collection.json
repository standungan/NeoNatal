              "raw": "{\n  \"baby_name\": \"Bayi Ny. Test\",\n  \"gender\": \"perempuan\",\n  \"birth_date\": \"2026-07-20\",\n  \"birth_weight\": 2100.0,\n  \"birth_length\": 45.0,\n  \"gestational_age\": 34,\n  \"birth_type\": \"Sectio Caesarea\",\n  \"clinical_notes\": \"Prematur, observasi ketat\",\n  \"parent\": {\n    \"mother_name\": \"Ny. Test\",\n    \"father_name\": \"Tn. Test\",\n    \"mother_phone\": \"081234567890\",\n    \"mother_medical_history\": null,\n    \"birth_history\": null,\n    \"delivery_history\": null,\n    \"additional_notes\": null\n  },\n  \"incubator_id\": \"{{incubator_id}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/babies", "host": ["{{base_url}}"], "path": ["api", "v1", "babies"] }
          }
        },
