{
  "info": {
    "name": "Neonatal Care API",
    "_postman_id": "b1e7c9a0-0000-4a00-9000-neonatalcare01",
    "description": "Neonatal Care System — FastAPI backend.\n\n## Setup\n1. Import this file into Postman.\n2. Open the collection **Variables** tab. `base_url` defaults to the live VPS `http://187.127.210.133:8000`. Change it to `http://localhost:8000` to hit a local backend.\n3. Run **Auth → Login** first — its test script stores the JWT into `{{access_token}}`, and every other request inherits Bearer auth from the collection automatically.\n\n## Self-priming ids\nRun **Incubators → List available** and **Babies → List** once; their test scripts populate `{{incubator_id}}` and `{{baby_id}}` from real data so the detail/create requests just work. Sensible seed defaults are pre-filled otherwise.\n\n## ⚠️ Writes hit real data\nPOST/PUT/DELETE mutate whatever `base_url` points at. Against the VPS that's the live demo DB — reseed with `backend/database/seed_data.sql` if you need a clean slate.\n\nSeeded logins (all password `Password123!`): `admin@neonatal.rs` · `siti.aisyah@neonatal.rs` (perawat) · `dr.anisa@neonatal.rs` (dokter).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://187.127.210.133:8000", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "role", "value": "", "type": "string" },
    { "key": "baby_id", "value": "cccccccc-0003-0003-0003-000000000001", "type": "string" },
    { "key": "incubator_id", "value": "bbbbbbbb-0002-0002-0002-000000000001", "type": "string" },
    { "key": "monitoring_id", "value": "", "type": "string" },
    { "key": "new_user_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health (no auth)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('access_token', j.access_token);",
                  "pm.collectionVariables.set('role', j.role);",
                  "console.log('Logged in as', j.full_name, '(' + j.role + ')');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@neonatal.rs\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard (stats + incubator grid)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/dashboard", "host": ["{{base_url}}"], "path": ["api", "v1", "dashboard"] }
          }
        }
      ]
    },
    {
      "name": "Incubators",
      "item": [
        {
          "name": "List all",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/incubators", "host": ["{{base_url}}"], "path": ["api", "v1", "incubators"] }
          }
        },
        {
          "name": "List available (sets incubator_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const arr = pm.response.json();",
                  "if (Array.isArray(arr) && arr.length) {",
                  "  pm.collectionVariables.set('incubator_id', arr[0].incubator_id);",
                  "  console.log('incubator_id =', arr[0].incubator_id);",
                  "} else { console.log('no kosong incubators — incubator_id left as-is'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/incubators/available", "host": ["{{base_url}}"], "path": ["api", "v1", "incubators", "available"] }
          }
        },
        {
          "name": "Get by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/incubators/{{incubator_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "incubators", "{{incubator_id}}"] }
          }
        },
        {
          "name": "Create (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"incubator_no\": \"99\",\n  \"location\": \"NICU Ruang Test\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/incubators", "host": ["{{base_url}}"], "path": ["api", "v1", "incubators"] }
          }
        },
        {
          "name": "Update (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"location\": \"NICU Ruang A (updated)\",\n  \"status\": \"tidak_tersedia\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/incubators/{{incubator_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "incubators", "{{incubator_id}}"] }
          }
        }
