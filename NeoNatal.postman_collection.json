              ]
            },
            "url": { "raw": "{{base_url}}/api/v1/monitoring/{{monitoring_id}}/photo", "host": ["{{base_url}}"], "path": ["api", "v1", "monitoring", "{{monitoring_id}}", "photo"] }
          }
        }
      ]
