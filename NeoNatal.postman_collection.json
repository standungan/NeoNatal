          "name": "Create (sets monitoring_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "if (j.monitoring_id) pm.collectionVariables.set('monitoring_id', j.monitoring_id);",
                  "console.log('vital_status =', j.vital_status);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observation_time\": \"{{$isoTimestamp}}\",\n  \"suhu_bayi\": 36.8,\n  \"suhu_inkubator\": 33.5,\n  \"kelembapan_inkubator\": 55.0,\n  \"heart_rate\": 128,\n  \"respiratory_rate\": 48,\n  \"spo2\": 98.0,\n  \"expression_score\": 3,\n  \"movement_score\": 4,\n  \"pain_score\": 1,\n  \"sleep_duration_min\": 120,\n  \"sleep_quality\": 4,\n  \"agitation_episodes\": 0,\n  \"catatan\": \"Bayi tenang (via Postman)\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/babies/{{baby_id}}/monitoring", "host": ["{{base_url}}"], "path": ["api", "v1", "babies", "{{baby_id}}", "monitoring"] }
          }
        },
        {
          "name": "List history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/babies/{{baby_id}}/monitoring?skip=0&limit=50",
