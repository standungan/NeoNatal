# Copy to .env on the VPS and fill in. Read by docker-compose.yml.
# The filled-in copy must never be committed — .gitignore already blocks it.

# ── Where the VPS lives ──────────────────────────────────────────────────────
# Your server's public IP. Used to build ALLOWED_ORIGINS for the Flutter app and
# for direct calls to :8000; the dashboard itself never needs it.
VPS_IP=203.0.113.10

# ── Ports published on the host ──────────────────────────────────────────────
# Dashboard on :80 so http://<vps-ip> just works. The API port is only for
# reaching /docs and /health while testing.
WEB_PORT=80
API_PORT=8000

# ── Postgres ─────────────────────────────────────────────────────────────────
# Never exposed to the host — reachable only from the other containers.
POSTGRES_DB=neonatal_db
POSTGRES_USER=neonatal_user
POSTGRES_PASSWORD=change-me-to-something-long

# ── Backend ──────────────────────────────────────────────────────────────────
# Generate a fresh one:  openssl rand -hex 32
# Do NOT reuse the key from backend/.env — that file is in the public
# neonatal-backend repo's git history, so its key is compromised.
SECRET_KEY=

# ── Web ──────────────────────────────────────────────────────────────────────
# false = the login cookie is allowed over plain HTTP. Required for an IP-only
# deploy; the JWT then travels in cleartext, so this is a testing posture, not a
# production one. Flip to true the moment you put HTTPS in front.
COOKIE_SECURE=false

# ── HTTPS only (docker-compose.tls.yml) ──────────────────────────────────────
# Ignored by the plain-HTTP setup. Fill in when you add a domain.
APP_DOMAIN=
API_DOMAIN=
LETSENCRYPT_EMAIL=
# Any non-empty value uses Let's Encrypt's staging CA — looser rate limits for a
# trial run, but the certs are not browser-trusted.
STAGING=
